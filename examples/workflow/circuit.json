{
  "version": 1,
  "name": "parity-generator-reference",
  "contract": "parity XOR into target, preserve inputs; exact basis-state reference",
  "argv": ["python3", "{dependency:generator}", "--width", "{setting:width}", "--seed", "{seed}"],
  "dependencies": {"generator": "circuit_generator.py"},
  "settings": {"width": 4},
  "outputs": [
    {"name": "circuit", "path": "circuit.kmx", "type": "text"},
    {"name": "resources", "path": "resources.json", "type": "json", "schema": {"type": "object", "required": ["gates", "wires"]}}
  ],
  "metrics": {
    "gates": {"output": "resources", "selector": "gates", "unit": "gates", "evidence_kind": "measured"},
    "wires": {"output": "resources", "selector": "wires", "unit": "wires", "evidence_kind": "measured"}
  },
  "verifier": {
    "version": "workflow-reference/1",
    "source": "examples/workflow/verify.py: independent exhaustive basis-state reference",
    "argv": ["python3", "{dependency:verify}", "circuit", "{artifact:circuit}", "--width", "{setting:width}"],
    "dependencies": {"verify": "verify.py"},
    "metrics": {"gates": "resources.gates", "wires": "resources.wires"}
  },
  "resources": {"threads": 1, "memory_bytes": 134217728, "storage_bytes": 1048576},
  "limits": {"timeout": 5, "memory_bytes": 134217728, "max_file_bytes": 1048576},
  "max_wall_seconds": 30,
  "max_attempts": 3,
  "cost": {"expression": "ceil(gates / 4) * 4 + wires", "unit": "reference_units", "resources": {"gates": "resources.gates", "wires": "resources.wires"}}
}
