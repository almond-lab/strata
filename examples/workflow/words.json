{
  "version": 1,
  "name": "word-frequency-reference",
  "contract": "exact lowercase ASCII token counts after a declared length filter",
  "argv": ["python3", "{dependency:counter}", "--input", "{input:text}", "--min-length", "{setting:min_length}", "--seed", "{seed}"],
  "dependencies": {"counter": "word_count.py"},
  "inputs": {"text": "sample.txt"},
  "settings": {"min_length": 3},
  "outputs": [
    {"name": "counts", "path": "counts.jsonl", "type": "jsonl", "schema": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["word", "count"], "properties": {"word": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}}}},
    {"name": "summary", "path": "summary.json", "type": "json"}
  ],
  "metrics": {
    "tokens": {"output": "summary", "selector": "/tokens", "unit": "tokens", "evidence_kind": "measured"},
    "vocabulary": {"output": "summary", "selector": "vocabulary", "unit": "words", "evidence_kind": "measured"}
  },
  "verifier": {
    "version": "workflow-reference/1",
    "source": "examples/workflow/verify.py: independent tokenization/count reference",
    "argv": ["python3", "{dependency:verify}", "words", "{artifact:counts}", "--input", "{input:text}", "--min-length", "{setting:min_length}"],
    "dependencies": {"verify": "verify.py"},
    "metrics": {"tokens": "resources.tokens", "vocabulary": "resources.vocabulary"}
  },
  "resources": {"threads": 1, "memory_bytes": 134217728, "storage_bytes": 1048576},
  "limits": {"timeout": 5, "memory_bytes": 134217728, "max_file_bytes": 1048576},
  "max_wall_seconds": 30,
  "max_attempts": 3,
  "cost": {"expression": "tokens + vocabulary", "unit": "reference_operations", "resources": {"tokens": "resources.tokens", "vocabulary": "resources.vocabulary"}}
}
